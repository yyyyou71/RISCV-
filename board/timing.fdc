# Reference PHY clocks plus new mailbox/monitor constraints.
# External HDMI input delay budget requires receiver/board timing data before sign-off.
create_clock -name {pclk} [get_pins {u_video.u_ips2l_pcie_wrap.U_IPS2L_PCIE_TOP.U_IPS2L_HSSTLP_PCIE_SOFT_PHY.pclk}] -period {4.000} -waveform {0.000 2.000}
create_clock -name {pclk_div2} [get_pins {u_video.u_ips2l_pcie_wrap.U_IPS2L_PCIE_TOP.U_IPS2L_HSSTLP_PCIE_SOFT_PHY.pclk_div2}] -period {8.000} -waveform {0.000 4.000}
create_clock -name {ref_clk} [get_pins {u_video.u_ips2l_pcie_wrap.U_IPS2L_PCIE_TOP.U_IPS2L_HSSTLP_PCIE_SOFT_PHY/P_REFCK2CORE_0}] -period {10.000} -waveform {0.000 5.000}
set_clock_groups -name group_1 -asynchronous -group [get_clocks {pclk}]
set_clock_groups -name group_2 -asynchronous -group [get_clocks {pclk_div2}]
set_clock_groups -name group_3 -asynchronous -group [get_clocks {ref_clk}]
create_clock -name {sys_clk} [get_ports {sys_clk}] -period {40.0} -waveform {0 20.0}
create_generated_clock -name {rst_clk} -source [get_ports {sys_clk}] [get_pins {u_video.u_hdmi_fifo.u_ddr3.u_ddrphy_top.rst_clk_gpll/clkout0}] -master_clock [get_clocks {sys_clk}] -multiply_by {84} -divide_by {84}
create_generated_clock -name {ddrphy_sysclk} -source [get_ports {sys_clk}] [get_pins {u_video.u_hdmi_fifo.u_ddr3.u_ddrphy_top.ddrphy_gpll/clkout0}] -master_clock [get_clocks {sys_clk}] -multiply_by {84} -divide_by {16}
create_generated_clock -name {phy_dq_clk_0} -source [get_ports {sys_clk}] [get_pins {u_video.u_hdmi_fifo.u_ddr3.u_ddrphy_top.ddrphy_slice_top.i_dqs_bank[0].ddrphy_ppll/clkoutphy}] -master_clock [get_clocks {sys_clk}] -multiply_by {84} -divide_by {2}
create_generated_clock -name {phy_dq_sysclk_0} -source [get_pins {u_video.u_hdmi_fifo.u_ddr3.u_ddrphy_top.ddrphy_slice_top.i_dqs_bank[0].ddrphy_ppll/clkoutphy}] [get_pins {u_video.u_hdmi_fifo.u_ddr3.u_ddrphy_top.ddrphy_slice_top.i_dqs_bank[0].u_ddrphy_ioclkdiv/CLKDIVOUT}] -master_clock [get_clocks {phy_dq_clk_0}] -edges {5 13 21} -edge_shift {0 0 0}
create_generated_clock -name {phy_dq_clk_1} -source [get_ports {sys_clk}] [get_pins {u_video.u_hdmi_fifo.u_ddr3.u_ddrphy_top.ddrphy_slice_top.i_dqs_bank[1].ddrphy_ppll/clkoutphy}] -master_clock [get_clocks {sys_clk}] -multiply_by {84} -divide_by {2}
create_generated_clock -name {phy_dq_sysclk_1} -source [get_pins {u_video.u_hdmi_fifo.u_ddr3.u_ddrphy_top.ddrphy_slice_top.i_dqs_bank[1].ddrphy_ppll/clkoutphy}] [get_pins {u_video.u_hdmi_fifo.u_ddr3.u_ddrphy_top.ddrphy_slice_top.i_dqs_bank[1].u_ddrphy_ioclkdiv/CLKDIVOUT}] -master_clock [get_clocks {phy_dq_clk_1}] -edges {5 13 21} -edge_shift {0 0 0}
# Preserve the reference DDR PHY interface timing recipe in full.
set_multicycle_path 2 -from [get_clocks ddrphy_sysclk] -to [get_clocks phy_dq_sysclk_0]
set_multicycle_path 2 -from [get_clocks ddrphy_sysclk] -to [get_clocks phy_dq_sysclk_1]
set_clock_uncertainty {0.4} -from [get_clocks {ddrphy_sysclk}] -to [get_clocks {phy_dq_sysclk_0}] -setup -hold
set_clock_uncertainty {0.4} -from [get_clocks {phy_dq_sysclk_0}] -to [get_clocks {ddrphy_sysclk}] -setup -hold
set_clock_uncertainty {0.4} -from [get_clocks {ddrphy_sysclk}] -to [get_clocks {phy_dq_sysclk_1}] -setup -hold
set_clock_uncertainty {0.4} -from [get_clocks {phy_dq_sysclk_1}] -to [get_clocks {ddrphy_sysclk}] -setup -hold
set_clock_groups -name rst_clk -asynchronous -group [get_clocks {rst_clk}]
set_clock_groups -name phy_dq_clk_0 -asynchronous -group [get_clocks {phy_dq_clk_0}]
set_clock_groups -name phy_dq_clk_1 -asynchronous -group [get_clocks {phy_dq_clk_1}]
set_clock_groups -asynchronous -group [get_clocks {ddrphy_sysclk}] -group [get_clocks {pclk pclk_div2 ref_clk}]
create_clock -name {hdmi_pixel} -period {6.734} [get_ports {pixclk_in}]
set_clock_uncertainty {0.200} [get_clocks {sys_clk}]
set_false_path -from [get_ports {key0_n perst_n}]
set_false_path -to [get_ports {led0 led1}]
# Bundled mailboxes / gray-pointer CDC: bound physical propagation, independent
# of clock insertion skew. A same-edge hold relationship does not exist here.
# Keep setup/max-delay analysis; do not cut the entire pair of clock domains.
set_max_delay -datapath_only 15.0 -from [get_clocks {sys_clk}] -to [get_clocks {ddrphy_sysclk}]
set_false_path -hold -from [get_clocks {sys_clk}] -to [get_clocks {ddrphy_sysclk}]
set_max_delay -datapath_only 40.0 -from [get_clocks {ddrphy_sysclk}] -to [get_clocks {sys_clk}]
set_false_path -hold -from [get_clocks {ddrphy_sysclk}] -to [get_clocks {sys_clk}]
set_max_delay -datapath_only 40.0 -from [get_clocks {hdmi_pixel}] -to [get_clocks {sys_clk}]
set_false_path -hold -from [get_clocks {hdmi_pixel}] -to [get_clocks {sys_clk}]
set_max_delay -datapath_only 6.5 -from [get_clocks {hdmi_pixel}] -to [get_clocks {ddrphy_sysclk}]
set_false_path -hold -from [get_clocks {hdmi_pixel}] -to [get_clocks {ddrphy_sysclk}]
set_max_delay -datapath_only 6.5 -from [get_clocks {ddrphy_sysclk}] -to [get_clocks {hdmi_pixel}]
set_false_path -hold -from [get_clocks {ddrphy_sysclk}] -to [get_clocks {hdmi_pixel}]
# Register-cell endpoints avoid assuming an RTL register has a physical /D pin
# before ADS mapping. Only the first stage is an endpoint; stage 2 stays timed.
set_false_path -to [get_cells -hierarchical {*u_window*req_meta*}]
set_false_path -to [get_cells -hierarchical {*u_window*ack_meta*}]
set_false_path -to [get_cells -hierarchical {*u_window*init_meta*}]
set_false_path -to [get_cells -hierarchical {*u_frames*req_meta*}]
set_false_path -to [get_cells -hierarchical {*u_frames*ack_meta*}]
set_false_path -to [get_cells -hierarchical {*u_frames*ready_meta*}]
set_false_path -to [get_cells -hierarchical {*u_frames*fault_meta*}]
set_false_path -to [get_cells -hierarchical {*u_video_monitor*meta*}]
set_false_path -to [get_cells -hierarchical {*u_hdmi_fifo*stream_meta*}]
# P2 request/result handshakes. Bundled buses retain the clock-pair maximum
# propagation budgets above; only asynchronous control first stages are cut.
set_false_path -to [get_cells -hierarchical {*u_preprocess*req_meta*}]
set_false_path -to [get_cells -hierarchical {*u_preprocess*ack_meta*}]
set_false_path -to [get_cells -hierarchical {*u_preprocess*ready_meta*}]
set_false_path -to [get_cells -hierarchical {*u_preprocess*fault_meta*}]
set_false_path -to [get_cells -hierarchical {*u_preprocess*start_meta*}]
set_false_path -to [get_cells -hierarchical {*u_preprocess*cancel_meta*}]
set_false_path -to [get_cells -hierarchical {*u_preprocess*sof_meta*}]
set_false_path -to [get_cells -hierarchical {*u_preprocess*done_meta*}]
set_false_path -to [get_cells -hierarchical {*u_write_ctrl*overflow_meta*}]
# PDS groups this two-bit pipe into one pre-synthesis cell. Restrict the source
# to the external ports: the stage-1 Q -> stage-2 D path is not waived.
set_false_path -from [get_ports {iic_scl iic_sda}] -to [get_cells -hierarchical {*u_frontend*sclPipe*0* *u_frontend*sdaPipe*0*}]

# FSPI 50MHz. IO delays are engineering budgets, pending full routed signoff.
create_clock -name {spi_clk} -period {20.000} -waveform {0.000 10.000} [get_ports {spi_clk}]
set_input_delay -clock [get_clocks {spi_clk}] -clock_fall -max 5.000 [get_ports {spi_data[*]}]
set_input_delay -clock [get_clocks {spi_clk}] -clock_fall -min 0.000 [get_ports {spi_data[*]}]
set_output_delay -clock [get_clocks {spi_clk}] -max 3.000 [get_ports {spi_data[*]}]
set_output_delay -clock [get_clocks {spi_clk}] -min 0.000 [get_ports {spi_data[*]}]
set_clock_uncertainty 0.200 [get_clocks {spi_clk}]
set_false_path -from [get_ports {spi_cs}]
# Bound bundled ownership/length crossings, retaining intra-domain timing.
set_max_delay -datapath_only 18.0 -from [get_clocks {sys_clk}] -to [get_clocks {spi_clk}]
set_max_delay -datapath_only 35.0 -from [get_clocks {spi_clk}] -to [get_clocks {sys_clk}]
set_false_path -hold -from [get_clocks {sys_clk}] -to [get_clocks {spi_clk}]
set_false_path -hold -from [get_clocks {spi_clk}] -to [get_clocks {sys_clk}]

# Controlled presentation mailbox: waive only first-stage control synchronizers.
set_false_path -to [get_cells -hierarchical {*u_present*req_meta*}]
set_false_path -to [get_cells -hierarchical {*u_present*ack_meta*}]
set_false_path -to [get_cells -hierarchical {*u_present*ready_meta*}]
set_false_path -to [get_cells -hierarchical {*u_present*lock_meta*}]
set_false_path -to [get_cells -hierarchical {*u_present*link_meta*}]
set_false_path -to [get_cells -hierarchical {*u_present*arm_meta*}]
set_false_path -to [get_cells -hierarchical {*u_present*done_meta*}]
set_false_path -to [get_cells -hierarchical {*u_present*fault_meta*}]
set_false_path -to [get_cells -hierarchical {*u_present*pc_req_meta*}]
