(_flow fab_demo "2022.2-SP6.4"
    (_comment "Generated by Fabric Compiler (version on 2022.2-SP6.4<build 146967>) at Fri Oct 30 17:34:06 2026")
    (_version "1.1.0")
    (_status "initial")
    (_project 
        (_option prj_work_dir (_string "."))
        (_option prj_impl_dir (_string "."))
    )
    (_task tsk_setup
        (_widget wgt_select_arch
            (_input
                (_part
                    (_family Logos2)
                    (_device PG2L100H)
                    (_speedgrade -6)
                    (_package FBG484)
                )
            )
        )
        (_widget wgt_my_design_src
            (_input
                (_file "fspi_loopback_top.v" + "fspi_loopback_top:"
                    (_format verilog)
                    (_timespec "2026-10-30T17:32:46")
                )
                (_file "fspi_sck_slave.v"
                    (_format verilog)
                    (_timespec "2026-10-30T17:32:46")
                )
                (_file "board_reset.v"
                    (_format verilog)
                    (_timespec "2026-10-30T17:32:46")
                )
            )
        )
        (_widget wgt_my_ips_src
        )
        (_widget wgt_import_logic_con_file
            (_input
                (_file "pins.fdc"
                    (_format fdc)
                    (_timespec "2026-10-30T17:32:46")
                )
                (_file "timing.fdc"
                    (_format fdc)
                    (_timespec "2026-10-30T17:32:46")
                )
            )
        )
        (_widget wgt_edit_user_cons
            (_attribute _click_to_run (_switch ON))
        )
        (_widget wgt_simulation
        )
    )
    (_task tsk_compile
        (_command cmd_compile
            (_gci_state (_integer 2))
            (_option top_module (_string "fspi_loopback_top"))
            (_db_output
                (_file "compile/fspi_loopback_top_comp.adf"
                    (_format adif)
                    (_timespec "2026-10-30T17:34:06")
                )
            )
            (_output
                (_file "compile/fspi_loopback_top.cmr"
                    (_format verilog)
                    (_timespec "2026-10-30T17:34:06")
                )
                (_file "compile/cmr.db"
                    (_format text)
                    (_timespec "2026-10-30T17:34:06")
                )
            )
        )
        (_widget wgt_rtl_view
            (_attribute _click_to_run (_switch ON))
        )
    )
    (_task tsk_synthesis
        (_command cmd_synthesize
            (_gci_state (_integer 0))
            (_option frequency (_string "25"))
            (_option selected_syn_tool_opt (_integer 2))
        )
        (_widget wgt_tech_view
            (_attribute _click_to_run (_switch ON))
        )
        (_widget wgt_map_constraint
        )
        (_widget wgt_my_fic_src
        )
        (_widget wgt_inserter_gui_view
            (_attribute _click_to_run (_switch ON))
        )
    )
    (_task tsk_devmap
        (_command cmd_devmap
            (_gci_state (_integer 0))
        )
        (_widget wgt_edit_placement_cons
            (_attribute _click_to_run (_switch ON))
        )
        (_widget wgt_edit_route_cons
            (_attribute _click_to_run (_switch ON))
        )
    )
    (_task tsk_pnr
        (_command cmd_pnr
            (_gci_state (_integer 0))
            (_option plc_decongestion (_integer 3))
            (_option gplace_seed (_integer 2))
            (_option groute_seed (_integer 2))
            (_option optimize_multi_corner_timing (_switch ON))
            (_option fix_hold_violation (_switch ON))
            (_option fix_hold_violation_iterations (_integer 15))
            (_option fix_hold_violation_threshold (_integer 200))
            (_option fix_hold_violation_threshold_for_clock_path_cross_srb (_integer 400))
            (_option fix_hold_violation_threshold_for_clk_tree (_integer 200))
            (_option max_hold_violated_paths_num (_integer 100000))
            (_option refineplacement_cluster (_boolean FALSE))
            (_option report_timing (_switch ON))
        )
        (_widget wgt_power_calculator
            (_attribute _click_to_run (_switch ON))
