<?xml version="1.0" encoding="UTF-8"?>
<ip_inst>
    <header>
        <vendor>Pango</vendor>
        <id>04100202</id>
        <display_name>DRM Based Simple Dual Port RAM</display_name>
        <name>28nm DRM Based Simple Dual Port RAM</name>
        <version>1.10</version>
        <instance>pango_pool_sum_ram</instance>
        <family>Logos2</family>
        <device>PG2L100H</device>
        <package>FBG484</package>
        <speedgrade>-6</speedgrade>
        <generator version="2022.2-SP6.1" build="138931">IP Compiler</generator>
    </header>
    <param_list>
        <param>
            <name>CAS_MODE_SEL</name>
            <value>DRM36K</value>
        </param>
        <param>
            <name>CAS_MODE</name>
            <value>36K</value>
        </param>
        <param>
            <name>POWER_OPT</name>
            <value>0</value>
        </param>
        <param>
            <name>RESET_TYPE</name>
            <value>SYNC</value>
        </param>
        <param>
            <name>SAMEWIDTH_EN</name>
            <value>1</value>
        </param>
        <param>
            <name>WR_BYTE_EN</name>
            <value>0</value>
        </param>
        <param>
            <name>BYTE_SIZE</name>
            <value>8</value>
        </param>
        <param>
            <name>WR_ADDR_WIDTH</name>
            <value>9</value>
        </param>
        <param>
            <name>WR_DATA_WIDTH</name>
            <value>48</value>
        </param>
        <param>
            <name>BE_WIDTH</name>
            <value>6</value>
        </param>
        <param>
            <name>WR_CLK_EN</name>
            <value>0</value>
        </param>
        <param>
            <name>WR_ADDR_STROBE_EN</name>
            <value>false</value>
        </param>
        <param>
            <name>RD_ADDR_WIDTH</name>
            <value>9</value>
        </param>
        <param>
            <name>RD_DATA_WIDTH</name>
            <value>48</value>
        </param>
        <param>
            <name>RD_BE_WIDTH</name>
            <value>6</value>
        </param>
        <param>
            <name>RD_CLK_EN</name>
            <value>1</value>
        </param>
        <param>
            <name>RD_ADDR_STROBE_EN</name>
            <value>false</value>
        </param>
        <param>
            <name>OUTPUT_REG</name>
            <value>0</value>
        </param>
        <param>
            <name>RD_OCE_EN</name>
            <value>false</value>
        </param>
        <param>
            <name>RD_CLK_OR_POL_INV</name>
            <value>0</value>
        </param>
        <param>
            <name>FAB_REG</name>
            <value>0</value>
        </param>
        <param>
            <name>INIT_EN</name>
            <value>0</value>
        </param>
        <param>
            <name>INIT_FILE</name>
            <value>NONE</value>
        </param>
        <param>
            <name>INIT_FORMAT</name>
            <value>BIN</value>
        </param>
        <param>
            <name>RST_VAL_EN</name>
            <value>0</value>
        </param>
        <param>
            <name>RST_VAL</name>
            <value>0</value>
        </param>
    </param_list>
    <pin_list/>
    <file_list>
        <output>
            <file pathname="generate.log" format="log" description="Generate Log"/>
            <file pathname="pango_pool_sum_ram_tb.v" format="verilog" description="Compiled File"/>
            <file pathname="pango_pool_sum_ram_tmpl.v" format="verilog" description="Instantiation Template"/>
            <file pathname="pango_pool_sum_ram_tmpl.vhdl" format="vhdl" description="Instantiation Template"/>
        </output>
        <source>
            <file pathname="rtl/ipm2l_sdpram_v1_10_pango_pool_sum_ram.v"/>
            <file pathname="pango_pool_sum_ram.v"/>
        </source>
    </file_list>
</ip_inst>
