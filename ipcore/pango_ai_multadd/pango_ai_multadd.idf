<?xml version="1.0" encoding="UTF-8"?>
<ip_inst>
    <header>
        <vendor>Pango</vendor>
        <id>04100302</id>
        <display_name>Multiply-Adder</display_name>
        <name>28nm Multiply-Adder</name>
        <version>1.5</version>
        <instance>pango_ai_multadd</instance>
        <family>Logos2</family>
        <device>PG2L100H</device>
        <package>FBG484</package>
        <speedgrade>-6</speedgrade>
        <generator version="2022.2-SP6.1" build="138931">IP Compiler</generator>
    </header>
    <param_list>
        <param>
            <name>ASIZE</name>
            <value>16</value>
        </param>
        <param>
            <name>BSIZE</name>
            <value>8</value>
        </param>
        <param>
            <name>A_SIGNED</name>
            <value>1</value>
        </param>
        <param>
            <name>B_SIGNED</name>
            <value>1</value>
        </param>
        <param>
            <name>ASYNC_RST</name>
            <value>0</value>
        </param>
        <param>
            <name>OPTIMAL_TIMING</name>
            <value>0</value>
        </param>
        <param>
            <name>INREG_EN</name>
            <value>0</value>
        </param>
        <param>
            <name>PIPEREG_EN_1</name>
            <value>1</value>
        </param>
        <param>
            <name>PIPEREG_EN_2</name>
            <value>1</value>
        </param>
        <param>
            <name>PIPEREG_EN_3</name>
            <value>1</value>
        </param>
        <param>
            <name>OUTREG_EN</name>
            <value>0</value>
        </param>
        <param>
            <name>PIPE_STATUS</name>
            <value>3</value>
        </param>
        <param>
            <name>ASYNC_RST_BOOL</name>
            <value>0</value>
        </param>
        <param>
            <name>DYN_ADDSUB_OP</name>
            <value>0</value>
        </param>
        <param>
            <name>ADDSUB_OP</name>
            <value>0</value>
        </param>
        <param>
            <name>OPTIMAL_TIMING_BOOL</name>
            <value>0</value>
        </param>
    </param_list>
    <pin_list/>
    <file_list>
        <output>
            <file pathname="generate.log" format="log" description="Generate Log"/>
            <file pathname="pango_ai_multadd_tb.v" format="verilog" description="Compiled File"/>
            <file pathname="pango_ai_multadd_tmpl.v" format="verilog" description="Instantiation Template"/>
            <file pathname="pango_ai_multadd_tmpl.vhdl" format="vhdl" description="Instantiation Template"/>
        </output>
        <source>
            <file pathname="rtl/ipm2l_multadd_v1_3_pango_ai_multadd.v"/>
            <file pathname="pango_ai_multadd.v"/>
        </source>
    </file_list>
</ip_inst>
